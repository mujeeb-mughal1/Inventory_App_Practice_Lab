<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
     <a href="/categories/new">New Category</a>
     <a href="/items/new">Add Item</a>
     <ul>
    <% categories.forEach(category => { %>
       
            <li>
                <a href="/categories/<%= category.id %>">
                    <%= category.name %>
                </a>
            </li>
            
            <% }) %>    
        </ul>
</body>
</html>