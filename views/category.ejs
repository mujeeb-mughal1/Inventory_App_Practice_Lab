    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
    </head>
    <body>
        <% items.map(item=>{%>
            <div>
            <h3><%= item.name %></h3>
            <p><%= item.description %></p>
            <p>$<%= item.price %></p>
            <p><%= item.quantity %></p>
            </div>
        <%}) %>
    </body>
    </html> 



